[node name="InstructionsLabel" type="RichTextLabel" parent="NotePopup/MarginContainer/VBoxContainer/ScrollContainer" unique_id=398387691]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
bbcode_enabled = true
text = "Granny's Technology Tips

1. [color=yellow]Parts:[/color] Go inside the small pantry in the lower right-hand corner and drag whatever square piece of equipment seems comfy into the large metallic case. You don't have to be concerned with where it should fit in; just press it down hard enough till you hear a sound, that's how you'll know it's secured!
2. [color=lightblue]Tools:[/color] Grab the metallic tool from the lower left-hand corner that seems to speak to your soul, honey! If there's some recalcitrant piece of equipment giving you trouble, give it a good whack with the heavy wrench—computers need a little encouragement sometimes!
3. [color=green]Sockets:[/color] Watch carefully how the slot treats its guest, honey! If it turns a fiery red, oh my, that's not a good sign—it's having a little hissy fit and you need to remove it immediately! If it turns a sunny yellow, it's friendly, but you need to take a tool and adjust it a bit. And if it turns a gentle green, that's good news—everything is okay and ready to go!"
fit_content = true

